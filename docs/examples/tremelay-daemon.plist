<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.tremelay.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/tremelay</string>
		<string>daemon</string>
		<string>--vault</string>
		<string>/Users/you/.tremelay/vault.db</string>
		<string>--idle-timeout</string>
		<string>8h</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>TREMELAY_PASSPHRASE</key>
		<string>replace-me</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
